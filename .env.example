# Somnia Shannon Testnet
PRIVATE_KEY=
SHANNON_RPC_URL=https://dream-rpc.somnia.network
ETHERSCAN_API_KEY=

# Frontend
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Relayer (optional — required only if you run `node scripts/relayer.mjs`
# directly or deploy the Dockerfile at the repo root. Vercel does NOT run the
# relayer; the hosted app is the frontend only. See scripts/relayer.mjs:14-22,
# 56-167 for the source of truth. All values fall back to sensible defaults;
# the EOA-namespaced cache files default to ./state/.)
#
# RELAYER_POLL_MS=30                         # seconds between main-loop ticks
# RELAYER_MAX_TOPUP_STT=1                    # max STT willing to spend on a single top-up
# RELAYER_MAX_BET_GAS=1                      # deprecated alias for RELAYER_MAX_TOPUP_STT
# RELAYER_MAX_ATTEMPTS=5                     # per-market resubmit cap before giving up
# RELAYER_VERBOSE=1                          # 1 = log every market scanned, 0 = log only retries
# PARSE_FAILURE_CACHE_FILE=                  # override default state/parse-failure-cache.<eoa>.json
# GENERATION_TOPICS_FILE=                    # override default scripts/topics.txt (one topic per line)
# SUBMITTED_TOPICS_FILE=                     # override default state/submitted-topics.<eoa>.json
# TOPIC_FEED_MAX_PER_TICK=1                  # bound the relayer's requestMarketGeneration submissions per tick
# RELAYER_LIQUIDITY_STT=0                    # v62: STT per side the relayer seeds on each new market (0 = disabled, default). 0.01 = 0.01 STT YES + 0.01 STT NO per market. Auto-claims on MarketResolved.
# RELAYER_SEED_MAX_PER_TICK=5                # v62: cap on seeds per main-loop tick (bounds the burst case on contract redeploy)

